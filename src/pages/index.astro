---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.js';
import { projects, clients } from '../data/projects.js';
import { categoryLabel, formatsOf } from '../data/categories.js';
import { u } from '../lib/url.js';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const reel = site.showreel.startsWith('/') ? base + site.showreel : site.showreel;
const featured = projects.filter((p) => p.featured);
const services = ['Filmy na YouTube', 'Rolki i content na social media', 'Sport i eventy', 'Motoryzacja', 'Zdjęcia', 'Montaż i color grading'];
---
<Base>
  <section class="hero">
    <video autoplay muted loop playsinline poster={u(site.showreelPoster)} src={reel}></video>
    <div class="shade"></div>
    <div class="hero-text wrap">
      <p class="mono"><span class="dot"></span>Showreel {new Date().getFullYear()}</p>
      <h1 class="display">Video<br />&amp; Photo</h1>
      <p class="tag">{site.tagline}</p>
    </div>
    <a href="#prace" class="scroll mono">Zobacz prace ↓</a>
  </section>

  <section id="prace" class="wrap featured" aria-labelledby="wybrane">
    <h2 id="wybrane" class="display head">Wybrane projekty</h2>
    {featured.map((p, i) => (
      <a href={`${base}/prace/${p.slug}`} class="feat reveal">
        <div class="feat-media">
          <img src={u(p.cover)} alt="" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
        </div>
        <div class="feat-text">
          <p class="mono">{String(i + 1).padStart(2, '0')} · {categoryLabel(p.category)}{p.year && ` · ${p.year}`}</p>
          <h3 class="display">{p.title}</h3>
          <p class="desc">{p.description}</p>
          <p class="mono sub">{p.clients.join(', ')} · {formatsOf(p).join(', ')}</p>
          <span class="go mono">Zobacz projekt →</span>
        </div>
      </a>
    ))}
    <a href={`${base}/prace`} class="all mono">Wszystkie prace ({projects.length}) →</a>
  </section>

  <section class="wrap band" aria-labelledby="klienci">
    <h2 id="klienci" class="mono">Pracowałem z</h2>
    <ul class="clients display">
      {clients.map((c) => <li>{c}</li>)}
    </ul>
  </section>

  <section class="wrap band" aria-labelledby="co-robie">
    <h2 id="co-robie" class="mono">Co robię</h2>
    <ul class="services">
      {services.map((s) => <li>{s}</li>)}
    </ul>
    <a class="btn mono" href={`mailto:${site.email}`}>Wyceń projekt →</a>
  </section>
</Base>

<style>
  .hero { position: relative; height: 100svh; min-height: 520px; overflow: hidden; }
  .hero video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.35), rgba(0,0,0,.15) 40%, rgba(11,11,11,1)); }
  .hero-text { position: absolute; bottom: 12vh; left: 0; right: 0; }
  h1 { font-size: clamp(72px, 17vw, 260px); line-height: .88; margin: 12px 0 16px; }
  .tag { max-width: 420px; color: #cfcfcf; }
  .scroll { position: absolute; right: var(--pad); bottom: 32px; color: #fff; padding: 12px 0; }

  .featured { padding-top: 96px; }
  .head { font-size: clamp(40px, 7vw, 96px); padding-bottom: 20px; margin-bottom: 48px; border-bottom: 1px solid var(--line); }
  .feat { display: grid; grid-template-columns: 1fr; gap: 20px; margin-bottom: 80px; }
  .feat-media { overflow: hidden; aspect-ratio: 16 / 9; background: #151515; }
  .feat-media img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s cubic-bezier(.2,.7,.2,1); }
  .feat:hover .feat-media img { transform: scale(1.03); }
  .feat-text > .mono:first-child { margin-bottom: 10px; }
  .feat h3 { font-size: clamp(40px, 6.4vw, 104px); line-height: 1.15; transition: color .3s; }
  .feat:hover h3, .feat:focus-visible h3 { color: var(--accent); }
  .desc { max-width: 560px; margin-top: 20px; color: #c9c9c9; font-size: 18px; line-height: 1.55; }
  .sub { margin-top: 20px; }
  .go { display: inline-flex; align-items: center; min-height: 44px; margin-top: 8px; color: var(--fg); }
  .feat:focus-visible { outline: 3px solid var(--accent); outline-offset: 8px; }
  @media (min-width: 900px) {
    .feat { grid-template-columns: 1.6fr 1fr; gap: 48px; align-items: end; }
    .feat:nth-of-type(even) { grid-template-columns: 1fr 1.6fr; }
    .feat:nth-of-type(even) .feat-media { order: 2; }
  }
  .all { display: inline-block; padding: 14px 22px; border: 1px solid var(--fg); color: var(--fg); transition: background .2s, color .2s; }
  .all:hover { background: var(--fg); color: var(--bg); }

  .band { padding-top: 96px; }
  .band h2 { margin-bottom: 24px; }
  .clients { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 28px; font-size: clamp(32px, 5vw, 64px); }
  .services { list-style: none; border-top: 1px solid var(--line); max-width: 760px; }
  .services li { padding: 16px 0; border-bottom: 1px solid var(--line); font-size: 18px; }
  .btn { display: inline-block; margin-top: 40px; padding: 18px 26px; background: var(--fg); color: var(--bg); transition: background .2s, color .2s; }
  .btn:hover { background: var(--accent); color: #fff; }
  @media (prefers-reduced-motion: reduce) { .feat-media img { transition: none; } }
</style>

---
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/projects.js';
import { u, watchUrl } from '../../lib/url.js';
import YouTube from '../../components/YouTube.astro';

export function getStaticPaths() {
  return projects.map((p, i) => ({
    params: { slug: p.slug },
    props: { project: p, next: projects[(i + 1) % projects.length] },
  }));
}
const { project: p, next } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={p.title} description={p.description}>
  <article class="wrap">
    <header class="top">
      <p class="mono"><span class="dot"></span>{p.type} · {p.client} · {p.year}</p>
      <h1 class="display">{p.title}</h1>
      <p class="desc">{p.description}</p>
      {p.role && <p class="role mono">Moja rola: {p.role}</p>}
    </header>

    {p.youtube && (
      <section class="ytwrap" aria-label="Filmy">
        <div class="reveal"><YouTube id={p.youtube[0].id} title={p.youtube[0].title} large /></div>
        <p class="ytcap">{p.youtube[0].title}</p>
        {p.highlight && <p class="highlight">{p.highlight}</p>}
        {p.youtube.length > 1 && (
          <>
            <h2 class="mono more">Więcej odcinków</h2>
            <ul class="ytgrid">
              {p.youtube.slice(1).map((v) => (
                <li class="reveal">
                  <YouTube id={v.id} title={v.title} />
                  <p class="ytcap small">{v.title}</p>
                </li>
              ))}
            </ul>
          </>
        )}
      </section>
    )}

    {p.type === 'video' && p.embed && (
      <div class="player reveal">
        <iframe src={p.embed} title={p.title} allow="autoplay; fullscreen; picture-in-picture" allowfullscreen loading="lazy"></iframe>
      </div>
    )}
    {p.type === 'video' && p.embed && (
      <a class="watch mono" href={watchUrl(p.embed)} target="_blank" rel="noopener">Oglądaj na {p.embed.includes('vimeo') ? 'Vimeo' : 'YouTube'} ↗</a>
    )}

    {p.type === 'photo' && (
      <div class="masonry">
        {p.photos.map((src, i) => (
          <button class="ph reveal" data-i={i} aria-label={`Powiększ zdjęcie ${i + 1}`}>
            <img src={u(src)} alt={`${p.title}, zdjęcie ${i + 1}`} loading="lazy" />
          </button>
        ))}
      </div>
    )}

    {p.credits && (
      <ul class="credits mono">{p.credits.map(c => <li>{c}</li>)}</ul>
    )}

    <a href={`${base}/work/${next.slug}`} class="next">
      <span class="mono">Następny projekt</span>
      <span class="display">{next.title} →</span>
    </a>
  </article>

  {p.type === 'photo' && (
    <div class="lightbox" hidden>
      <button class="lb-close mono" aria-label="Zamknij">Close ✕</button>
      <button class="lb-prev" aria-label="Poprzednie">←</button>
      <img alt="" />
      <button class="lb-next" aria-label="Następne">→</button>
    </div>
  )}
</Base>

<script>
  const lb = document.querySelector('.lightbox');
  if (lb) {
    const imgs = [...document.querySelectorAll('.ph img')].map(i => i.src);
    const view = lb.querySelector('img');
    let cur = 0;
    const show = (i) => { cur = (i + imgs.length) % imgs.length; view.src = imgs[cur]; };
    const open = (i) => { show(i); lb.hidden = false; document.body.style.overflow = 'hidden'; };
    const close = () => { lb.hidden = true; document.body.style.overflow = ''; };
    document.querySelectorAll('.ph').forEach(b => b.addEventListener('click', () => open(+b.dataset.i)));
    lb.querySelector('.lb-close').onclick = close;
    lb.querySelector('.lb-prev').onclick = () => show(cur - 1);
    lb.querySelector('.lb-next').onclick = () => show(cur + 1);
    lb.addEventListener('click', e => { if (e.target === lb) close(); });
    addEventListener('keydown', e => {
      if (lb.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(cur - 1);
      if (e.key === 'ArrowRight') show(cur + 1);
    });
  }
</script>

<style>
  .top { padding-top: 160px; margin-bottom: 56px; max-width: 1100px; }
  h1 { font-size: clamp(56px, 11vw, 170px); margin: 16px 0 24px; }
  .desc { max-width: 560px; color: #c9c9c9; font-size: 18px; }
  .player { aspect-ratio: 16/9; background: #000; }
  .role { margin-top: 20px; color: var(--fg); }
  .ytcap { margin-top: 12px; font-size: 18px; }
  .ytcap.small { font-size: 16px; color: #c9c9c9; }
  .highlight { margin-top: 20px; max-width: 640px; padding-left: 16px; border-left: 2px solid var(--accent); color: #e6e6e6; }
  .more { margin: 72px 0 24px; }
  .ytgrid { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 40px 24px; }
  .player iframe { width: 100%; height: 100%; border: 0; }
  .watch { display: inline-block; margin-top: 16px; }
  .watch:hover { color: var(--accent); }
  .masonry { columns: 3 320px; column-gap: 16px; }
  .ph { display: block; width: 100%; margin-bottom: 16px; border: 0; padding: 0; background: none; cursor: zoom-in; break-inside: avoid; overflow: hidden; }
  .ph img { width: 100%; transition: transform .8s cubic-bezier(.2,.7,.2,1); }
  .ph:hover img { transform: scale(1.03); }
  .credits { list-style: none; margin-top: 48px; display: grid; gap: 8px; }
  .next { display: block; margin-top: 120px; padding-top: 32px; border-top: 1px solid var(--line); }
  .next .display { display: block; font-size: clamp(40px, 8vw, 120px); margin-top: 12px; transition: color .3s; }
  .next:hover .display { color: var(--accent); }
  .lightbox { position: fixed; inset: 0; z-index: 90; background: rgba(5,5,5,.96); display: flex; align-items: center; justify-content: center; }
  .lightbox[hidden] { display: none; }
  .lightbox img { max-width: 88vw; max-height: 86vh; object-fit: contain; }
  .lightbox button { position: absolute; background: none; border: 0; color: #fff; cursor: pointer; font-size: 28px; padding: 16px; }
  .lb-close { top: 16px; right: 16px; font-size: 12px !important; }
  .lb-prev { left: 8px; } .lb-next { right: 8px; }
</style>

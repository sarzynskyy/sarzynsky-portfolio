---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects.js';
import { categories } from '../../data/categories.js';
const used = categories
  .map((c) => ({ ...c, count: projects.filter((p) => p.category === c.id).length }))
  .filter((c) => c.count > 0);
---
<Base title="Prace" description="Filmy, rolki i zdjęcia: sport, motoryzacja, reklama i eventy." crumbs={[{ label: 'Prace' }]}>
  <section class="wrap page">
    <h1 class="display">Prace</h1>
    <div class="filters" role="group" aria-label="Filtruj według kategorii" hidden>
      <button type="button" class="mono" data-f="all" aria-pressed="true">Wszystkie ({projects.length})</button>
      {used.map((c) => (
        <button type="button" class="mono" data-f={c.id} aria-pressed="false">{c.label} ({c.count})</button>
      ))}
    </div>
    <p class="mono status" aria-live="polite"></p>
    <div class="grid">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>
</Base>

<script>
  // Filtr działa tylko z JS; bez JS widać wszystkie projekty, a przyciski są ukryte.
  const box = document.querySelector<HTMLElement>('.filters');
  const status = document.querySelector<HTMLElement>('.status');
  if (box) {
    box.hidden = false;
    const btns = [...box.querySelectorAll<HTMLButtonElement>('button')];
    btns.forEach((b) => b.addEventListener('click', () => {
      btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      const f = b.dataset.f;
      let n = 0;
      document.querySelectorAll<HTMLElement>('.card').forEach((c) => {
        const show = f === 'all' || c.dataset.category === f;
        c.hidden = !show;
        if (show) n++;
      });
      if (status) status.textContent = `Pokazuję ${n} z ${document.querySelectorAll('.card').length} projektów`;
    }));
  }
</script>

<style>
  .page { padding-top: 16px; }
  h1 { font-size: clamp(64px, 12vw, 170px); margin-bottom: 32px; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 8px; }
  .filters[hidden] { display: none; }
  .filters button { font: inherit; letter-spacing: inherit; text-transform: inherit; min-height: 44px; padding: 10px 16px; color: var(--muted); background: none; border: 1px solid var(--line); cursor: pointer; transition: all .2s; }
  .filters button:hover, .filters button[aria-pressed='true'] { color: var(--bg); background: var(--fg); border-color: var(--fg); }
  .filters button:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  .status { min-height: 1.5em; margin-bottom: 32px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 380px), 1fr)); gap: 64px 32px; }
  .grid :global(.card[hidden]) { display: none; }
</style>

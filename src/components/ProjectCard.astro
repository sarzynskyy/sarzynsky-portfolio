---
import { u } from '../lib/url.js';
import { categoryLabel, formatsOf } from '../data/categories.js';
const { project: p } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<a href={`${base}/prace/${p.slug}`} class="card reveal" data-category={p.category}>
  <div class="media">
    <img src={u(p.cover)} alt="" loading="lazy" decoding="async" />
  </div>
  <p class="mono meta">{categoryLabel(p.category)}{p.year && ` · ${p.year}`}</p>
  <h3 class="display">{p.title}</h3>
  <p class="sub">{p.clients.join(', ')} · {formatsOf(p).join(', ')}</p>
</a>
<style>
  .card { display: block; }
  .media { overflow: hidden; aspect-ratio: 16 / 10; background: #151515; }
  .media img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s cubic-bezier(.2,.7,.2,1); }
  .card:hover .media img { transform: scale(1.04); }
  .meta { margin-top: 16px; }
  h3 { font-size: clamp(28px, 3.4vw, 44px); margin-top: 6px; transition: color .3s; }
  .card:hover h3, .card:focus-visible h3 { color: var(--accent); }
  .sub { margin-top: 6px; color: #b5b5b5; }
  .card:focus-visible { outline: 3px solid var(--accent); outline-offset: 6px; }
  @media (prefers-reduced-motion: reduce) { .media img { transition: none; } }
</style>

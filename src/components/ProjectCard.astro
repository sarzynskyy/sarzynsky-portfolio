---
const { project, index } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const n = String(index + 1).padStart(2, '0');
---
<a href={`${base}/work/${project.slug}`} class="card reveal" data-type={project.type}>
  <div class="media">
    <img src={project.cover} alt={project.title} loading="lazy" />
    <span class="badge mono">{project.type === 'video' ? '▶ Video' : '◉ Photo'}</span>
  </div>
  <div class="meta">
    <span class="mono">{n}</span>
    <h3 class="display">{project.title}</h3>
    <span class="mono">{project.client} · {project.year}</span>
  </div>
</a>
<style>
  .card { display: block; }
  .media { position: relative; overflow: hidden; aspect-ratio: 16/10; background: #151515; }
  .media img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(.85) contrast(1.05); transform: scale(1.02); transition: filter .6s, transform 1.2s cubic-bezier(.2,.7,.2,1); }
  .card:hover .media img { filter: grayscale(0); transform: scale(1.07); }
  .badge { position: absolute; top: 14px; left: 14px; color: #fff; background: rgba(0,0,0,.45); padding: 6px 10px; backdrop-filter: blur(6px); }
  .meta { display: grid; grid-template-columns: 40px 1fr auto; align-items: baseline; gap: 12px; padding-top: 14px; }
  h3 { font-size: clamp(26px, 3.2vw, 44px); transition: color .3s; }
  .card:hover h3 { color: var(--accent); }
  @media (max-width: 600px) { .meta { grid-template-columns: 32px 1fr; } .meta > :last-child { grid-column: 2; } }
</style>

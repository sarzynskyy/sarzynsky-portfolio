---
import { site } from '../data/site.js';
---
<footer class="wrap">
  <a href={`mailto:${site.email}`} class="cta display">Napisz do mnie<span>→</span></a>
  <div class="row mono">
    <span>{site.location}</span>
    <a href={site.instagram} target="_blank" rel="noopener">Instagram</a>
    <a href={`mailto:${site.email}`}>{site.email}</a>
    <span>© {new Date().getFullYear()} {site.name}</span>
  </div>
</footer>
<style>
  footer { border-top: 1px solid var(--line); margin-top: 120px; padding-top: 64px; padding-bottom: 32px; }
  .cta { display: inline-flex; gap: .3em; font-size: clamp(48px, 10vw, 160px); transition: color .3s; }
  .cta span { transition: transform .3s; }
  .cta:hover { color: var(--accent); }
  .cta:hover span { transform: translateX(.15em); }
  .row { display: flex; flex-wrap: wrap; gap: 12px 32px; justify-content: space-between; margin-top: 48px; }
  .row a:hover { color: var(--fg); }
</style>

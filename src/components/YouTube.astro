---
// Lekki player YouTube: najpierw tylko miniatura z naszego serwera.
// YouTube (w trybie bez ciasteczek) ładuje się dopiero po kliknięciu.
// Bez JavaScriptu działa jako zwykły link do filmu na YouTube.
import { u } from '../lib/url.js';
const { id, title, large = false } = Astro.props;
if (!/^[\w-]{11}$/.test(id)) throw new Error(`Nieprawidłowe ID YouTube: ${id}`);
---
<a
  class:list={['yt', { large }]}
  href={`https://www.youtube.com/watch?v=${id}`}
  data-yt={id}
  data-title={title}
  target="_blank"
  rel="noopener"
>
  <img src={u(`/yt/${id}.webp`)} alt="" width="1280" height="720" loading={large ? 'eager' : 'lazy'} decoding="async" />
  <span class="play" aria-hidden="true"></span>
  <span class="visually-hidden">Odtwórz film: {title}</span>
</a>

<script>
  document.querySelectorAll<HTMLAnchorElement>('a.yt').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      const id = a.dataset.yt!;
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&playsinline=1`;
      f.title = a.dataset.title || 'Film YouTube';
      f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      f.allowFullscreen = true;
      f.referrerPolicy = 'strict-origin-when-cross-origin';
      f.className = 'yt-frame';
      a.replaceWith(f);
      f.focus();
    });
  });
</script>

<style>
  .yt { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; background: #111; cursor: pointer; }
  .yt img { width: 100%; height: 100%; object-fit: cover; transition: transform .8s cubic-bezier(.2,.7,.2,1); }
  .yt:hover img { transform: scale(1.03); }
  .play { position: absolute; left: 50%; top: 50%; width: 64px; height: 64px; margin: -32px 0 0 -32px; border-radius: 50%; background: rgba(0,0,0,.6); border: 1px solid rgba(255,255,255,.7); transition: background .2s, transform .2s; }
  .play::after { content: ''; position: absolute; left: 26px; top: 20px; border-style: solid; border-width: 12px 0 12px 19px; border-color: transparent transparent transparent #fff; }
  .large .play { width: 88px; height: 88px; margin: -44px 0 0 -44px; }
  .large .play::after { left: 35px; top: 27px; border-width: 17px 0 17px 26px; }
  .yt:hover .play, .yt:focus-visible .play { background: var(--accent); transform: scale(1.06); }
  .yt:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  :global(.yt-frame) { display: block; width: 100%; aspect-ratio: 16 / 9; border: 0; background: #000; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (prefers-reduced-motion: reduce) { .yt img, .play { transition: none; } }
</style>

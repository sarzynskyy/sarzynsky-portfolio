---
// Osadzony player YouTube (tryb bez ciasteczek: youtube-nocookie.com).
// Filmy niżej na stronie ładują się dopiero przy przewinięciu (loading="lazy").
const { id, title, large = false } = Astro.props;
if (!/^[\w-]{11}$/.test(id)) throw new Error(`Nieprawidłowe ID YouTube: ${id}`);
---
<div class:list={['yt', { large }]}>
  <iframe
    src={`https://www.youtube-nocookie.com/embed/${id}?rel=0&playsinline=1`}
    title={title || 'Film YouTube'}
    loading={large ? 'eager' : 'lazy'}
    allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen"
    allowfullscreen
    referrerpolicy="strict-origin-when-cross-origin"
  ></iframe>
</div>

<style>
  .yt { position: relative; aspect-ratio: 16 / 9; background: #111; }
  .yt iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>

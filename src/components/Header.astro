---
// Stały pasek u góry każdej strony: logo + menu, zawsze na ciemnym, lekko rozmytym tle.
import { site } from '../data/site.js';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname;
const links = [
  { href: `${base}/prace`, label: 'Prace' },
  { href: `${base}/cennik`, label: 'Cennik' },
  { href: `${base}/o-mnie`, label: 'O mnie' },
  { href: `mailto:${site.email}`, label: 'Kontakt', cta: true },
];
const isActive = (href) => href.startsWith('/') && path.startsWith(href);
---
<header class="bar">
  <div class="inner wrap">
    <a href={`${base}/`} class="logo display" aria-label={`${site.name}, strona główna`}>{site.name}</a>
    <nav aria-label="Menu główne">
      <ul>
        {links.map((l) => (
          <li>
            <a href={l.href} class:list={[{ active: isActive(l.href), cta: l.cta }]} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .bar {
    position: fixed; top: 0; left: 0; right: 0; z-index: 50; height: var(--header-h);
    background: rgba(11,11,11,.9); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(255,255,255,.08);
  }
  .inner { height: 100%; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .logo { font-size: clamp(24px, 2.6vw, 34px); color: #fff; letter-spacing: .02em; }
  nav ul { list-style: none; display: flex; align-items: center; gap: clamp(4px, 1.6vw, 12px); }
  nav a {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 clamp(8px, 1.2vw, 16px);
    font-size: clamp(14px, 1.2vw, 17px); font-weight: 500; letter-spacing: .04em; text-transform: uppercase; color: #fff;
    border-bottom: 2px solid transparent; transition: color .2s, border-color .2s, background .2s;
  }
  nav a:hover { color: var(--accent); }
  nav a.active { border-bottom-color: var(--accent); }
  nav a.cta { border: 1px solid #fff; margin-left: 4px; }
  nav a.cta:hover { background: #fff; color: var(--bg); }
  nav a:focus-visible, .logo:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  @media (max-width: 420px) {
    .logo { font-size: 20px; }
    nav ul { gap: 0; }
    nav a { padding: 0 7px; font-size: 12px; letter-spacing: .02em; }
    nav a.cta { margin-left: 2px; }
  }
</style>

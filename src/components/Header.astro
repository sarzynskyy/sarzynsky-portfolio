---
// Stały pasek u góry każdej strony: logo + menu, zawsze na ciemnym, lekko rozmytym tle.
import { site } from '../data/site.js';
import Cart from './Cart.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname;
const links = [
  { href: `${base}/prace`, label: 'Prace' },
  { href: `${base}/cennik`, label: 'Cennik' },
  { href: `${base}/o-mnie`, label: 'O mnie' },
  { href: `mailto:${site.email}`, label: 'Kontakt', cta: true },
];
const isActive = (href) => href.startsWith('/') && path.startsWith(href);
---
<header class="bar">
  <div class="inner wrap">
    <a href={`${base}/`} class="logo display" aria-label={`${site.name}, strona główna`}>{site.name}</a>
    <nav aria-label="Menu główne">
      <ul id="menu">
        {links.map((l) => (
          <li>
            <a href={l.href} data-cart-open={l.cta ? '' : undefined} data-topic={l.cta ? 'Kontakt' : undefined} class:list={[{ active: isActive(l.href), cta: l.cta }]} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="tools">
      <Cart />
      <button type="button" class="menu-btn" aria-expanded="false" aria-controls="menu" aria-label="Menu">
        <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<script>
  // Menu na telefonie: przycisk otwiera listę linków pod paskiem; Esc i klik w link zamykają.
  const bar = document.querySelector<HTMLElement>('.bar')!;
  const btn = bar.querySelector<HTMLButtonElement>('.menu-btn')!;
  const set = (open: boolean) => { bar.classList.toggle('open', open); btn.setAttribute('aria-expanded', String(open)); btn.setAttribute('aria-label', open ? 'Zamknij menu' : 'Menu'); };
  btn.addEventListener('click', () => set(!bar.classList.contains('open')));
  bar.querySelectorAll('#menu a').forEach((a) => a.addEventListener('click', () => set(false)));
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && bar.classList.contains('open')) { set(false); btn.focus(); } });
  matchMedia('(min-width: 721px)').addEventListener('change', () => set(false));
</script>

<style>
  .bar {
    position: fixed; top: 0; left: 0; right: 0; z-index: 50; height: var(--header-h);
    background: rgba(11,11,11,.9); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(255,255,255,.08);
  }
  .inner { height: 100%; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .logo { font-size: clamp(24px, 2.6vw, 34px); color: #fff; letter-spacing: .02em; }
  nav ul { list-style: none; display: flex; align-items: center; gap: clamp(4px, 1.6vw, 12px); }
  nav a {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 clamp(8px, 1.2vw, 16px);
    font-size: clamp(14px, 1.2vw, 17px); font-weight: 500; letter-spacing: .04em; text-transform: uppercase; color: #fff;
    border-bottom: 2px solid transparent; transition: color .2s, border-color .2s, background .2s;
  }
  nav a:hover { color: var(--accent); }
  nav a.active { border-bottom-color: var(--accent); }
  nav a.cta { border: 1px solid #fff; margin-left: 4px; }
  nav a.cta:hover { background: #fff; color: var(--bg); }
  nav a:focus-visible, .logo:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  .tools { display: flex; align-items: center; gap: 4px; }
  .inner > nav { margin-left: auto; }
  .menu-btn { display: none; width: 44px; height: 44px; align-items: center; justify-content: center; background: none; border: 0; color: #fff; cursor: pointer; }
  .menu-btn:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  .bars { position: relative; width: 22px; height: 14px; }
  .bars i { position: absolute; left: 0; width: 100%; height: 2px; background: currentColor; border-radius: 1px; transition: transform .25s, opacity .2s, top .25s; }
  .bars i:nth-child(1) { top: 0; } .bars i:nth-child(2) { top: 6px; } .bars i:nth-child(3) { top: 12px; }
  .open .bars i:nth-child(1) { top: 6px; transform: rotate(45deg); }
  .open .bars i:nth-child(2) { opacity: 0; }
  .open .bars i:nth-child(3) { top: 6px; transform: rotate(-45deg); }

  /* Telefon: logo, koszyk i przycisk menu; linki w rozwijanym panelu pod paskiem */
  @media (max-width: 720px) {
    :global(.js) .menu-btn { display: inline-flex; }
    :global(.js) nav ul {
      position: fixed; top: var(--header-h); left: 0; right: 0; flex-direction: column; align-items: stretch; gap: 0;
      padding: 8px var(--pad) 20px; background: var(--bg); border-bottom: 1px solid var(--line);
      visibility: hidden; opacity: 0; translate: 0 -8px; transition: opacity .2s, translate .2s, visibility 0s .2s;
    }
    :global(.js) .open nav ul { visibility: visible; opacity: 1; translate: 0 0; transition: opacity .2s, translate .2s; }
    :global(.js) nav a { width: 100%; min-height: 52px; padding: 0; font-size: 18px; border-bottom: 1px solid var(--line); }
    :global(.js) nav a.active { color: var(--accent); border-bottom-color: var(--line); }
    :global(.js) nav a.cta { justify-content: center; margin: 16px 0 0; border: 1px solid #fff; }
    :global(html:not(.js)) .inner { flex-wrap: wrap; height: auto; }
  }
  @media (prefers-reduced-motion: reduce) { .bars i, nav ul { transition: none !important; } }
</style>

---
// Ścieżka okruszków: Start / … / bieżąca strona. Plus dane strukturalne BreadcrumbList dla Google.
const { items = [] } = Astro.props; // [{ label, href? }], ostatni element to bieżąca strona
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const crumbs = [{ label: 'Start', href: `${base}/` }, ...items];
const origin = Astro.site ? Astro.site.origin : '';
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    ...(c.href ? { item: origin + c.href } : {}),
  })),
};
---
<nav class="crumbs wrap" aria-label="Ścieżka nawigacji">
  <ol>
    {crumbs.map((c, i) => (
      <li>
        {i < crumbs.length - 1 && c.href
          ? <a href={c.href}>{c.label}</a>
          : <span aria-current="page">{c.label}</span>}
      </li>
    ))}
  </ol>
</nav>
<script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />

<style>
  .crumbs { padding-top: calc(var(--header-h) + 20px); }
  ol { list-style: none; display: flex; flex-wrap: wrap; align-items: center; font-size: 14px; color: var(--muted); }
  li { display: inline-flex; align-items: center; }
  li + li::before { content: '/'; margin: 0 10px; color: #555; }
  a { display: inline-flex; align-items: center; min-height: 44px; color: #cfcfcf; text-decoration: underline; text-decoration-color: rgba(255,255,255,.25); text-underline-offset: 4px; transition: color .2s, text-decoration-color .2s; }
  a:hover { color: var(--accent); text-decoration-color: var(--accent); }
  a:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  [aria-current='page'] { color: #fff; }
</style>

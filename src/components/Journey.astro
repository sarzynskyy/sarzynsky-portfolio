---
// Droga do celu jako pozioma trasa (stepper): etapy w jednym rzędzie,
// pod spodem jeden panel z filmem i dystansem wybranego etapu.
// Animacje: punkty pojawiają się po kolei po wejściu w widok, czerwony pasek jedzie
// do wybranego etapu, panel płynnie się zmienia, pasek dystansu rośnie.
// Wszystko wyłączone przy prefers-reduced-motion.
import YouTube from './YouTube.astro';
const { journey, videos = [] } = Astro.props;
const titleOf = (id) => videos.find((v) => v.id === id)?.title ?? '';
const total = (s) => (s.swim ?? 0) + (s.bike ?? 0) + (s.run ?? 0);
const nodes = journey.stages.map((s) => ({ ...s, km: total(s) }));
const max = Math.max(...nodes.map((n) => n.km));
const km = (n) => n.toLocaleString('pl-PL', { maximumFractionDigits: 2 });
const uid = `j-${Math.random().toString(36).slice(2, 8)}`;
---
<section class="journey" aria-labelledby={`${uid}-h`} data-journey style="--p:0">
  <h2 id={`${uid}-h`} class="display">{journey.title}</h2>
  {journey.intro && <p class="intro">{journey.intro}</p>}

  <div class="nodes" role="tablist" aria-label="Etapy">
    {nodes.map((n, i) => (
      <button
        type="button"
        role="tab"
        id={`${uid}-tab-${i}`}
        aria-controls={`${uid}-panel-${i}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        class:list={['node', { finish: n.finish }]}
        style={`--i:${i}`}
      >
        <span class="dot" aria-hidden="true">{n.finish ? '★' : ''}</span>
        <span class="lbl display">{n.label}</span>
        <span class="kmsmall mono">{n.km > 0 ? `${km(n.km)} km` : 'pomiary'}</span>
      </button>
    ))}
  </div>

  <div class="panels">
    {nodes.map((n, i) => (
      <div class="panel" role="tabpanel" id={`${uid}-panel-${i}`} aria-labelledby={`${uid}-tab-${i}`}>
        <div class="info">
          <p class="mono step">Etap {i + 1} z {nodes.length}</p>
          <p class="big display">{n.label}</p>
          <h3>{n.name}</h3>
          {n.km > 0 && (
            <div class="dist">
              <div class="bar" aria-hidden="true"><span style={`--w:${(n.km / max).toFixed(3)}`}></span></div>
              <p class="mono kmline">{km(n.km)} km</p>
              <p class="mono split">pływanie {km(n.swim)} km · rower {km(n.bike)} km · bieg {km(n.run)} km</p>
            </div>
          )}
          <div class="nav">
            {i > 0 && <button type="button" class="mono step-btn" data-go={i - 1}>← {nodes[i - 1].label}</button>}
            {i < nodes.length - 1 && <button type="button" class="mono step-btn" data-go={i + 1}>{nodes[i + 1].label} →</button>}
          </div>
        </div>
        {n.video && <div class="film"><YouTube id={n.video} title={titleOf(n.video)} /></div>}
      </div>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-journey]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    root.classList.add('js');

    const select = (i: number, focus = false) => {
      tabs.forEach((t, k) => {
        const on = k === i;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        t.classList.toggle('passed', k < i);
      });
      panels.forEach((p, k) => (p.hidden = k !== i));
      root.style.setProperty('--p', String(i / Math.max(1, tabs.length - 1)));
      if (focus) tabs[i].focus();
    };

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        const map: Record<string, number> = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: last };
        if (e.key in map) { e.preventDefault(); select(Math.max(0, Math.min(last, map[e.key])), true); }
      });
    });
    root.querySelectorAll<HTMLButtonElement>('[data-go]').forEach((b) =>
      b.addEventListener('click', () => select(+b.dataset.go!, true))
    );
    select(0);

    // punkty pojawiają się po kolei, gdy sekcja wjedzie w widok
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => es.forEach((e) => {
        if (e.isIntersecting) { root.classList.add('drawn'); io.disconnect(); }
      }), { threshold: 0.25 });
      io.observe(root);
    } else {
      root.classList.add('drawn');
    }
  });
</script>

<style>
  .journey { margin-top: 112px; }
  .journey h2 { font-size: clamp(40px, 7vw, 96px); }
  .intro { margin: 12px 0 0; max-width: 560px; color: #c9c9c9; }

  /* ---------- Trasa ---------- */
  .nodes { --dot: 22px; --pad: 24px; position: relative; display: flex; justify-content: space-between; margin: 28px 0 24px; }
  .nodes::before, .nodes::after {
    content: ''; position: absolute; left: var(--pad); top: calc(13px + var(--dot) / 2 - 2px); height: 4px; border-radius: 2px;
  }
  .nodes::before { right: var(--pad); background: #3d3d3d; }
  .nodes::after { width: calc((100% - 2 * var(--pad)) * var(--p)); background: var(--accent); transition: width .6s cubic-bezier(.6,.1,.2,1); }

  .node {
    position: relative; z-index: 1; width: 48px; display: flex; flex-direction: column; align-items: center;
    padding: 0; border: 0; background: none; color: #fff; cursor: pointer;
  }
  .dot {
    display: grid; place-items: center; width: var(--dot); height: var(--dot); margin: 13px; border-radius: 50%;
    background: var(--bg); border: 3px solid #fff; font-size: 11px; line-height: 1; color: #fff;
    transition: transform .25s, background .25s, border-color .25s;
  }
  .node.passed .dot { background: var(--accent); border-color: var(--accent); }
  .node[aria-selected='true'] .dot { background: var(--accent); border-color: #fff; transform: scale(1.3); box-shadow: 0 0 0 6px rgba(232,69,44,.25); }
  .node:hover .dot { transform: scale(1.2); }
  .node:focus-visible { outline: none; }
  .node:focus-visible .dot { outline: 3px solid var(--accent); outline-offset: 4px; }
  .lbl { margin-top: -4px; font-size: 15px; line-height: 1.1; letter-spacing: .02em; white-space: nowrap; transition: color .25s; }
  .node[aria-selected='true'] .lbl { color: var(--accent); }
  .kmsmall { display: none; margin-top: 4px; font-size: 11px; white-space: nowrap; }

  /* ---------- Panel wybranego etapu ---------- */
  .panel { display: flex; flex-direction: column; gap: 14px; }
  .panel[hidden] { display: none; }
  .film { order: -1; }
  .js .panel:not([hidden]) { animation: fade .45s ease both; }
  .step, .big { display: none; }
  h3 { font-size: 18px; font-weight: 500; }
  .dist { margin-top: 10px; max-width: 420px; }
  .bar { height: 6px; background: #262626; border-radius: 3px; overflow: hidden; }
  .bar span { display: block; height: 100%; width: calc(var(--w) * 100%); background: var(--accent); border-radius: 3px; transform-origin: left; }
  .js .panel:not([hidden]) .bar span { animation: grow .8s .1s cubic-bezier(.2,.7,.2,1) both; }
  .kmline { margin-top: 10px; color: var(--fg); font-size: 14px; }
  .split { margin-top: 4px; font-size: 11px; }
  .nav { display: flex; gap: 8px; margin-top: 12px; }
  .step-btn { flex: 1; font: inherit; letter-spacing: inherit; text-transform: inherit; min-height: 44px; padding: 10px 16px; color: var(--fg); background: none; border: 1px solid var(--line); cursor: pointer; transition: background .2s, color .2s; }
  .step-btn:hover { background: var(--fg); color: var(--bg); }
  .step-btn:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }

  /* ---------- Komputer: większa trasa z kilometrami, opis obok filmu ---------- */
  @media (min-width: 760px) {
    .nodes { --dot: 28px; --pad: 50px; margin: 40px 0 36px; }
    .node { width: 100px; }
    .lbl { font-size: clamp(22px, 2.6vw, 34px); }
    .kmsmall { display: block; }
    .panel { display: grid; grid-template-columns: 1fr minmax(0, 560px); gap: 48px; align-items: start; }
    .film { order: 2; }
    .step, .big { display: block; }
    .step { margin-bottom: 4px; }
    .big { font-size: clamp(56px, 7vw, 104px); line-height: .85; }
    h3 { margin-top: 8px; font-size: 20px; }
    .dist { margin-top: 16px; }
    .split { font-size: 12px; }
    .nav { margin-top: 24px; }
    .step-btn { flex: 0 1 auto; }
  }

  /* ---------- Animacje wejścia ---------- */
  .js .node { opacity: 0; transform: translateY(10px) scale(.8); transition: opacity .35s, transform .35s; transition-delay: calc(.1s + var(--i) * .1s); }
  .js.drawn .node { opacity: 1; transform: none; }
  .js .nodes::before { transform-origin: left; transform: scaleX(0); transition: transform .9s cubic-bezier(.6,.1,.2,1); }
  .js.drawn .nodes::before { transform: scaleX(1); }

  @keyframes fade { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @keyframes grow { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  @media (prefers-reduced-motion: reduce) {
    .js .node, .js .nodes::before, .nodes::after, .dot, .lbl { transition: none !important; }
    .js .node { opacity: 1; transform: none; }
    .js .nodes::before { transform: none; }
    .js .panel:not([hidden]), .js .panel:not([hidden]) .bar span { animation: none; }
  }
</style>
